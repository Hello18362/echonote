# 数据库
DATABASE_URL="file:./dev.db"

# ============================================================
# 访问口令：只在「网站放到公网」时才需要填
#
# 留空 = 完全不启用门禁，本地和局域网用法和以前一模一样。
# 填了之后，任何没带签名的请求都会被挡到 /login，输入这个口令才能进。
#
# 注意这不是账号系统，只有一把锁。口令建议 12 位以上、带点符号，
# 因为它同时是 cookie 签名的密钥材料——改口令会让所有设备立刻重新登录。
# ============================================================
ACCESS_PASSWORD=""

# ============================================================
# 语音识别（负责"听"）：必须用专门的 ASR 模型，对话模型不能转写
# 留空则走 Mock，也就是固定输出一份演示会议内容
#
# 推荐：硅基流动，SenseVoiceSmall 标注免费，国内直连
#   申请：https://cloud.siliconflow.cn/me/account/ak （需实名认证）
#   ASR_BASE_URL="https://api.siliconflow.cn/v1"
#   ASR_MODEL="FunAudioLLM/SenseVoiceSmall"
#
# 备选：智谱   ASR_BASE_URL="https://open.bigmodel.cn/api/paas/v4"  ASR_MODEL="glm-asr-2512"
# 备选：百炼   ASR_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"  ASR_MODEL="paraformer-v2"
#
# 别手改，跑一条命令更稳：node scripts/check-api.mjs --provider siliconflow --key sk-xxx --write
# ============================================================
ASR_BASE_URL=""
ASR_API_KEY=""
ASR_MODEL="whisper-1"

# ============================================================
# 大模型（负责"写"纪要）：填你的中转站地址与对话模型名
# 地址要填到 /v1 为止，程序会自动拼 /chat/completions
# 服务商不提供音频接口没关系，转写交给上面的 ASR 就行
# ============================================================
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# ============================================================
# 单个音频上传上限（MB），默认 200
# 上传是流式落盘，不会把整个文件读进内存；上限开大主要影响磁盘占用
# ============================================================
# MAX_UPLOAD_MB="200"

# ============================================================
# 录音收件箱：手机录音丢进这个文件夹就会自动导入并转写
# 留空 = 项目根目录下的「录音收件箱」
# ============================================================
# INBOX_DIR=""

# 设为 0 = 只导入不自动转写（排查问题或想手动点「重新处理」时用）
# INBOX_AUTO_PROCESS="1"

# ============================================================
# ffprobe 路径：收件箱用它读音频时长。留空则依次找 PATH、
# 以及 winget 安装的 Gyan.FFmpeg 默认目录
# ============================================================
# FFPROBE_PATH=""
