{
  "name": "echonote",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:https": "next dev --experimental-https -H 0.0.0.0",
    "icons": "node scripts/make-icons.mjs",
    "build": "prisma generate && next build",
    "start": "next start",
    "serve": "node scripts/serve-https.mjs",
    "boot": "node scripts/boot.mjs",
    "lan:url": "node scripts/lan-url.mjs",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint",
    "smoke": "node scripts/smoke.mjs",
    "api:check": "node scripts/check-api.mjs",
    "backup": "node scripts/backup.mjs",
    "pack": "node scripts/pack-data.mjs",
    "qr": "node scripts/show-qr.mjs",
    "db:push": "prisma db push",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "docx": "^9.15.1",
    "next": "14.2.15",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.39",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.16.0",
    "qrcode-terminal": "^0.12.0",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3"
  }
}
