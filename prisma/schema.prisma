generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Recording {
  id         String   @id @default(uuid())
  title      String   @default("未命名录音")
  duration   Int      @default(0) // 秒
  transcript String?  @default("") // 完整逐字稿
  summary    String?  @default("") // AI 摘要
  todos      String?  @default("[]") // JSON 数组字符串
  todosDone  String?  @default("[]") // 已勾选的待办下标，JSON 数字数组
  keyPoints  String?  @default("[]") // JSON 数组字符串
  tags       String   @default("[]") // 用户标签，JSON 数组字符串
  status     String   @default("pending") // pending|transcribing|summarizing|done|error
  error      String?
  mock       Boolean  @default(false) // true = 内容来自内置示例，与录音无关
  edited     Boolean  @default(false) // true = 用户手动改过正文，不再是纯 AI 输出
  shareToken String?  @unique // 只读分享令牌，null 表示未分享
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt // 用于识别"处理中途被打断"
}

/// 服务商配置：优先于 .env，改完立即生效
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
